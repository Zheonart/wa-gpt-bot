# ── OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low   # minimal|low|medium — kosongkan untuk model non-reasoning

# ── WAHA (di VPS Hostinger) ─────────────────────────
WAHA_URL=https://waha.domainkamu.com
WAHA_API_KEY=isi-kalau-waha-pakai-api-key
WAHA_SESSION=default

# ── Keamanan webhook (opsional tapi disarankan) ──────
# Set header X-Webhook-Secret di WAHA dengan nilai yang sama
WEBHOOK_SECRET=

# ── Redis (Railway: otomatis dari service Redis) ─────
# Kosongkan untuk pakai memori (riwayat hilang saat restart)
REDIS_URL=

# ── Perilaku bot ─────────────────────────────────────
DEBOUNCE_MS=4000          # jeda sunyi sebelum pesan digabung & diproses
MAX_CONCURRENT=8          # berapa percakapan diproses paralel
HISTORY_TURNS=20          # riwayat yang dikirim ke GPT
REPLY_GAP_MIN_MS=900      # jeda minimum antar bubble
REPLY_GAP_MAX_MS=2200     # jeda maksimum antar bubble
TIMEZONE=Asia/Riyadh      # memori & bahasa reset tiap 00:00 di zona ini
OFFTOPIC_MAX=3            # peringatan ke-N untuk pertanyaan di luar topik → kunci
LOCK_MINUTES=60           # lama chat dikunci (bot diam total)
LOCK_MESSAGE=This chat is locked for a few hours. Please message us again later.\nتم قفل هذه المحادثة لبضع ساعات. يرجى مراسلتنا لاحقاً.
BOT_NAME=Mia
BUSINESS_NAME=BON Cafe

PORT=3000
